# Required
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_PASSWORD=choose-a-long-password
MISTRAL_API_KEY=
# Owner two-step login + alerts + comm-link replies
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Private-area access keys (leave empty to disable an area)
SARA_PASSPHRASE=
EGI_PASSPHRASE=
# Words typed into the company box that open private doors (each door still needs its secret)
# SARA_TRIGGER=wife
# EGI_TRIGGER=egi
# ADMIN_TRIGGER=sudo override
# Optional
MISTRAL_MEDIUM_KEY=
DISCORD_WEBHOOK=
# Set to 0 only for local http development
COOKIE_SECURE=1
# Set to 1 behind a reverse proxy (Render, Fly, nginx) so rate limits see real IPs
TRUST_PROXY=1
DATA_DIR=./data
